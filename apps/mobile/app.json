{
  "expo": {
    "name": "KAMPRO",
    "slug": "vasudha-connect",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "vasudhaconnect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "android": {
      "package": "com.vasudha.connect",
      "versionCode": 1,
      "permissions": [
        "POST_NOTIFICATIONS",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single"
    }
  }
}
